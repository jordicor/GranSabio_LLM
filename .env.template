# Gran Sabio LLM Engine - Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your API keys

# Required API Keys for AI Services
# =================================

# OpenAI API Key (for GPT models)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional personal ChatGPT plan (separate from OpenAI API billing).
# Connect at http://127.0.0.1:8000/admin/subscription after enabling and restarting.
# Use one engine process. Credentials stay outside the repository.
PERSONAL_SUBSCRIPTIONS_ENABLED=false
# Optional absolute private directory; default: ~/.config/gransabio/personal
PERSONAL_SUBSCRIPTION_DIR=

# Anthropic API Key (for Claude models)  
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-api-key-here

# Google AI API Key (for Gemini models)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-ai-api-key-here

# xAI API Key (for Grok models)
# Get from: https://console.x.ai/
XAI_API_KEY=xai-your-xai-key-here

# OpenRouter API Key (for additional hosted models)
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-your-openrouter-key-here

# MiniMax API Key (for MiniMax M-series models)
# Get from: https://platform.minimax.io/
MINIMAX_API_KEY=your-minimax-api-key-here

# Moonshot/Kimi API Key (for Kimi models)
# Get from: https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=your-moonshot-api-key-here

# TypeSafe API Key (for Jev System One decisions; not a chat model)
# Get from: https://console.typesafe.ai/
TYPESAFE_API_KEY=your-typesafe-api-key-here
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Attachment Storage
# ==================
# Required for attachment functionality. Use any random string.
# This pepper is used to hash usernames for storage paths.
PEPPER=your-random-secret-pepper-here

# Optional Configuration
# =====================

# FastAPI Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# Admin access follows the internal client-IP policy. Literal server IPs in
# those networks also work as admin Hosts by default, with same-origin checks.
# Override the client networks for your deployment (CIDRs, comma-separated):
# INTERNAL_ALLOWED_CIDRS=127.0.0.0/8,::1/128,192.168.1.0/24
# Optional strict Host override for DNS names or selected server IPs; replaces
# the default Host policy. Use hostnames/IPs only, without schemes or ports.
# ADMIN_ALLOWED_HOSTNAMES=localhost,127.0.0.1,::1,gransabio.example.test

# Request Limits
MAX_CONCURRENT_REQUESTS=10
# Stateless context preflight uses each model's native capacity, with no global
# token ceiling. GRANSABIO_CONTEXT_POLICY_MAX_TOKENS is retired and ignored.
# Consumers may set a smaller maximum_working_context_tokens in their request.
GRANSABIO_CONTEXT_POLICY_SAFETY_MARGIN=0.05
OLLAMA_HOST=http://localhost:11434
# Administrative identity used by execution_policy.scope=local_only. The URL
# remains server configuration; requests cannot override it.
OLLAMA_ENDPOINT_ALIAS=ollama
OLLAMA_MAX_CONCURRENT_REQUESTS=1
# Optional administrative JSON inventory for multiple local inference APIs.
# When set, it replaces the singleton OLLAMA_HOST/LLAMACPP_BASE_URL inventory;
# do not combine it with non-default legacy endpoint settings.
# Endpoint entries use endpoint_id, adapter, base_url, optional api_key_env,
# max_concurrent_requests, and availability (loaded by default). Never put an
# API secret in this JSON; api_key_env names its environment variable instead.
# LOCAL_ENDPOINTS_CONFIG_PATH=local_endpoints.json
# Optional physical GPU coordinator; not enabled by the endpoint registry.
# Use one engine process and keep its durable state on a local disk.
# LOCAL_RESOURCES_CONFIG_PATH=local_resources.local.json
# LOCAL_RESOURCES_STATE_PATH=data/local_resources.sqlite3
# Optional separate llama.cpp OpenAI-compatible server. Keep this on its own
# host/queue; it is not an Ollama fallback.
LLAMACPP_BASE_URL=
LLAMACPP_API_KEY=llama.cpp
LLAMACPP_ENDPOINT_ALIAS=llamacpp
LLAMACPP_MAX_CONCURRENT_REQUESTS=1
LLAMACPP_MAX_OUTPUT_TOKENS=4096
SDK_LLAMACPP_TIMEOUT_SECONDS=12000
REQUEST_TIMEOUT=12000
REQUEST_TIMEOUTS_DEFAULT_PATH=request_timeouts.default.json
# Optional local override file. This file is ignored by git so each deployment can tune waits.
REQUEST_TIMEOUTS_PATH=request_timeouts.json
MAX_RETRIES=5
RETRY_DELAY=15.0
RETRY_BACKOFF_MULTIPLIER=2.0
RETRY_MAX_DELAY=120.0
RETRY_JITTER=true

# External generation token floor (optional)
# Protects public /generate requests from very small max_tokens values.
# Per-model entries accept "model:min_tokens" pairs separated by commas.
EXTERNAL_GENERATION_MIN_TOKENS_ENABLED=true
EXTERNAL_GENERATION_MIN_TOKENS_REASONING=4096
# EXTERNAL_GENERATION_MIN_TOKENS_DEFAULT=4096
# EXTERNAL_GENERATION_MIN_TOKENS_MODELS=gpt-5.5:4096,gpt-5.4:4096

# Session Management
MAX_ACTIVE_SESSIONS=100
SESSION_TIMEOUT=3600
GENERATION_IDEMPOTENCY_TTL_SECONDS=86400
GENERATION_IDEMPOTENCY_MAX_ENTRIES=10000
SESSION_CLEANUP_INTERVAL=300
SESSION_CLEANUP_IDLE_EMPTY_CHECKS=3
SESSION_CLEANUP_IDLE_INTERVAL=3600
# CLEANUP_INTERVAL is still accepted as a legacy alias for SESSION_CLEANUP_INTERVAL

# Logging
LOG_LEVEL=INFO
VERBOSE_MAX_ENTRIES=100

# Runtime model routing
# Model defaults live in this JSON file, not in config.py or model_specs.json.
LLM_ROUTING_DEFAULT_PATH=llm_routing.default.json

# Quality Standards (optional)
DEFAULT_MIN_GLOBAL_SCORE=8.0
DEFAULT_MAX_ITERATIONS=5

# Smart Edit Configuration (optional)
# Maximum paragraphs that can be edited in a single smart edit iteration
MAX_PARAGRAPHS_PER_INCREMENTAL_RUN=12

# Evidence Grounding model routing lives in llm_routing.default.json
# under evidence.extract_claims and evidence.score_logprobs.
