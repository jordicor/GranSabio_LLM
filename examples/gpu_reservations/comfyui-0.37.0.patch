+"""Correlated model-release receipts from ComfyUI's existing prompt worker.
+
+Proposed companion: no CUDA import or lifecycle operation occurs on import.
+Only the prompt worker may call complete(), after native memory cleanup.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Callable
+from uuid import UUID, uuid4
+
+PROTOCOL = "gransabio.gpu-barrier.v1"
+
+
+class ResourceBarrierBusy(RuntimeError):
+    """The queue or another release operation owns the worker."""
+
+
+def physical_gpu_uuid() -> str:
+    """Identify the actual single CUDA device; never substitute an ordinal."""
+    import comfy.model_management as management
+
+    devices = management.get_all_torch_devices()
+    if len(devices) != 1 or devices[0].type != "cuda":
+        raise RuntimeError("The resource barrier requires exactly one visible CUDA device")
+    value = str(management.torch.cuda.get_device_properties(devices[0]).uuid)
+    value = value.removeprefix("GPU-")
+    return f"GPU-{UUID(value)}"
+
+
+def loaded_model_classes() -> list[str]:
+    """Report current model classes; these are not invented model filenames."""
+    import comfy.model_management as management
+
+    return [type(getattr(item.model, "model", item.model)).__name__ for item in list(management.current_loaded_models)]
+
+
+class ResourceBarrier:
+    """Keep queue admission and release acknowledgment under the same mutex."""
+
+    def __init__(self, queue, *, gpu_uuid: Callable[[], str] = physical_gpu_uuid,
+                 loaded_models: Callable[[], list[str]] = loaded_model_classes):
+        self.queue = queue
+        self.gpu_uuid = gpu_uuid
+        self.loaded_models = loaded_models
+        self.instance_id = str(uuid4())
+        self.generation = 0
+        self.memory_released = False
+        self.operations: dict[str, dict] = {}
+
+    def work_queued(self) -> None:
+        """Invalidate old memory receipts before a new prompt becomes visible."""
+        with self.queue.mutex:
+            self.generation += 1
+            self.memory_released = False
+
+    def status(self, request_id: str | None = None) -> dict:
+        """Return historical operation state together with current device state."""
+        with self.queue.mutex:
+            operation = self.operations[request_id] if request_id is not None else None
+            models = self.loaded_models()
+            idle = not self.queue.queue and not self.queue.currently_running
+            result = {"protocol": PROTOCOL, "instance_id": self.instance_id,
+                      "gpu_uuid": self.gpu_uuid(), "idle": idle,
+                      "memory_released": self.memory_released and idle and not models,
+                      "loaded_model_classes": models}
+            if operation is not None:
+                result.update(request_id=request_id, state=operation["state"], error=operation.get("error"))
+            return result
+
+    def request_release(self, request_id: str) -> dict:
+        """Queue native cleanup once; HTTP acceptance is never completion."""
+        request_id = str(UUID(request_id))
+        with self.queue.mutex:
+            if request_id in self.operations:
+                return self.status(request_id)
+            if self.queue.queue or self.queue.currently_running or any(item["state"] == "pending" for item in self.operations.values()):
+                raise ResourceBarrierBusy("ComfyUI has active/queued work or another release")
+            self.gpu_uuid()  # Reject unsupported/unknown device identity before setting flags.
+            self.operations[request_id] = {"state": "pending", "generation": self.generation}
+            self.memory_released = False
+            self.queue.set_flag("gransabio_release_request", request_id)
+            self.queue.set_flag("unload_models", True)
+            self.queue.set_flag("free_memory", True)
+            return self.status(request_id)
+
+    def complete(self, request_id: str) -> None:
+        """Acknowledge only after the real worker's full cleanup and CUDA sync."""
+        with self.queue.mutex:
+            operation = self.operations[request_id]
+            if (operation["generation"] != self.generation or self.queue.queue
+                    or self.queue.currently_running or self.loaded_models()):
+                self.fail(request_id, "work_changed_or_models_remain")
+                return
+            operation["state"] = "completed"
+            self.memory_released = True
+
+    def fail(self, request_id: str, reason: str) -> None:
+        """Preserve a failed operation instead of issuing a success receipt."""
+        with self.queue.mutex:
+            self.operations[request_id].update(state="failed", error=reason)
+            self.memory_released = False
+            logging.error("GPU release barrier %s failed: %s", request_id, reason)
